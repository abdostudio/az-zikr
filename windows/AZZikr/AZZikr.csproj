<Project Sdk="Microsoft.NET.Sdk">
  <!-- .NET Framework 4.8 ships with every Windows 10/11: no runtime to install, tiny exe, low RAM. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AZZikr</AssemblyName>
    <RootNamespace>AZZikr</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>1.0.0</Version>
    <Product>AZ Zikr</Product>
    <Company>AZ Creative</Company>
    <Copyright>Abdelrahman Ahmed · Idea by Sherif Tolba</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared UI (same files as the Mac build) -->
    <None Include="..\..\web\**\*" LinkBase="web" CopyToOutputDirectory="PreserveNewest" />
    <None Include="tray.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
